# Dev: relative path -> handled by the Vite proxy (see vite.config.ts).
# CORS is bypassed because the browser talks to the same origin.
VITE_API_URL=/v1

# Тайминги игры, мс (необязательные, указаны дефолты).
VITE_FLIP_MS=300       # флип-анимация карты
VITE_MATCH_MS=600      # задержка фиксации совпавшей пары
VITE_MISMATCH_MS=900   # показ несовпавших карт перед закрытием
VITE_IDLE_MS=30000     # порог простоя: дольше — время не засчитывается
VITE_HINT_MS=1500      # длительность подсветки подсказки
