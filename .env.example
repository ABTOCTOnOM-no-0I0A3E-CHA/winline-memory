# Base URL of the backend API.
# Dev: use "/v1" with the Vite proxy (default in .env.development).
# Prod: full absolute URL incl. /v1, e.g. https://api.example.com/v1
#       (backend must allow the prod origin in CORS_ALLOW_ORIGINS).
VITE_API_URL=

# Тайминги игры в миллисекундах (необязательные, указаны дефолты).
VITE_FLIP_MS=450       # флип-анимация карты
VITE_MATCH_MS=600      # задержка фиксации совпавшей пары
VITE_MISMATCH_MS=900   # показ несовпавших карт перед закрытием
VITE_IDLE_MS=30000     # порог простоя: дольше — время не засчитывается
VITE_HINT_MS=1500      # длительность подсветки подсказки
